    {
      "name": "9. Deposit into wallet (alice) - 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/wallets/{{walletId}}/deposits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wallets",
            "{{walletId}}",
            "deposits"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"amount\": 100.0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{aliceToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"balance credited\", () => pm.expect(pm.response.json().balance).to.eql(100));"
            ]
          }
        }
      ]
