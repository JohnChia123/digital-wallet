  "item": [
    {
      "name": "1. Create wallet (alice) - 201",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wallets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wallets"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{aliceToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"walletId\", pm.response.json().walletId);"
            ]
          }
        }
      ]
    },
